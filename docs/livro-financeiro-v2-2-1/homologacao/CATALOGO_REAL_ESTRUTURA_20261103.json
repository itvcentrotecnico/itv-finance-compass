  "constraints": [
    {
      "nome": "auditoria_acao_check",
      "tipo": "c",
      "tabela": "auditoria",
      "definicao": "CHECK ((acao = ANY (ARRAY['criar'::text, 'alterar'::text, 'inativar'::text, 'reativar'::text])))"
    },
    {
      "nome": "chk_codigo_centro_custo",
      "tipo": "c",
      "tabela": "centros_custo",
      "definicao": "CHECK (((codigo)::text ~ '^[A-Za-z0-9._-]{1,32}$'::text))"
    },
    {
      "nome": "chk_descricao_centro_custo",
      "tipo": "c",
      "tabela": "centros_custo",
      "definicao": "CHECK (((length(btrim((descricao)::text)) >= 2) AND (length(btrim((descricao)::text)) <= 160)))"
    },
    {
      "nome": "chk_nome_conta_financeira",
      "tipo": "c",
      "tabela": "contas_financeiras",
      "definicao": "CHECK (((length(btrim((nome)::text)) >= 2) AND (length(btrim((nome)::text)) <= 160)))"
    },
    {
      "nome": "contas_financeiras_moeda_check",
      "tipo": "c",
      "tabela": "contas_financeiras",
      "definicao": "CHECK ((moeda = 'BRL'::bpchar))"
    },
    {
      "nome": "contas_financeiras_tipo_check",
      "tipo": "c",
      "tabela": "contas_financeiras",
      "definicao": "CHECK (((tipo)::text = ANY ((ARRAY['banco'::character varying, 'caixa'::character varying])::text[])))"
    },
    {
      "nome": "contas_preparadas_check",
      "tipo": "c",
      "tabela": "contas_preparadas",
      "definicao": "CHECK (((situacao = 'habilitada'::text) = ((conta_financeira_id IS NOT NULL) AND (data_abertura IS NOT NULL) AND (saldo_validado IS NOT NULL) AND (responsavel_conferencia IS NOT NULL))))"
    },
    {
      "nome": "contas_preparadas_nome_check",
      "tipo": "c",
      "tabela": "contas_preparadas",
      "definicao": "CHECK (((length(btrim((nome)::text)) >= 2) AND (length(btrim((nome)::text)) <= 160)))"
    },
    {
      "nome": "contas_preparadas_situacao_check",
      "tipo": "c",
      "tabela": "contas_preparadas",
      "definicao": "CHECK ((situacao = ANY (ARRAY['pendente_abertura'::text, 'habilitada'::text])))"
    },
    {
      "nome": "contas_preparadas_tipo_check",
      "tipo": "c",
      "tabela": "contas_preparadas",
      "definicao": "CHECK (((tipo)::text = ANY ((ARRAY['banco'::character varying, 'caixa'::character varying])::text[])))"
    },
    {
      "nome": "diagnostico_autorizacoes_check",
      "tipo": "c",
      "tabela": "diagnostico_autorizacoes",
      "definicao": "CHECK ((encerra_em > criado_em))"
    },
    {
      "nome": "diagnostico_autorizacoes_consumidas_check",
      "tipo": "c",
      "tabela": "diagnostico_autorizacoes",
      "definicao": "CHECK (((consumidas >= 0) AND (consumidas <= 5)))"
    },
    {
      "nome": "diagnostico_tentativas_categoria_check",
      "tipo": "c",
      "tabela": "diagnostico_tentativas",
      "definicao": "CHECK ((categoria = ANY (ARRAY['leitura_valida'::text, 'autenticacao_origem'::text, 'autorizacao_origem'::text, 'limite_origem'::text, 'erro_interno_origem'::text, 'http_origem'::text, 'resposta_invalida_origem'::text, 'timeout_origem'::text, 'configuracao_origem'::text, 'rede_origem'::text, 'invocacao_origem'::text, 'conexao_origem'::text, 'leitura_nao_autorizada'::text, 'falha_interna'::text, 'concorrencia'::text, 'repeticao'::text, 'limite'::text, 'autorizacao_inativa'::text])))"
    },
    {
      "nome": "diagnostico_tentativas_check",
      "tipo": "c",
      "tabela": "diagnostico_tentativas",
      "definicao": "CHECK (((estado = 'bloqueada'::text) = (ordinal IS NULL)))"
    },
    {
      "nome": "diagnostico_tentativas_check1",
      "tipo": "c",
      "tabela": "diagnostico_tentativas",
      "definicao": "CHECK (((estado <> 'reservada'::text) OR ((categoria IS NULL) AND (status_http IS NULL) AND (duracao_ms IS NULL) AND (tipo_excecao IS NULL) AND (concluido_em IS NULL))))"
    },
    {
      "nome": "diagnostico_tentativas_check2",
      "tipo": "c",
      "tabela": "diagnostico_tentativas",
      "definicao": "CHECK (((estado <> ALL (ARRAY['concluida'::text, 'falha'::text])) OR ((categoria IS NOT NULL) AND (duracao_ms IS NOT NULL) AND (concluido_em IS NOT NULL))))"
    },
    {
      "nome": "diagnostico_tentativas_check3",
      "tipo": "c",
      "tabela": "diagnostico_tentativas",
      "definicao": "CHECK (((estado <> 'concluida'::text) OR (categoria = 'leitura_valida'::text)))"
    },
    {
      "nome": "diagnostico_tentativas_check4",
      "tipo": "c",
      "tabela": "diagnostico_tentativas",
      "definicao": "CHECK (((estado <> 'bloqueada'::text) OR (categoria = ANY (ARRAY['concorrencia'::text, 'repeticao'::text, 'limite'::text, 'autorizacao_inativa'::text]))))"
    },
    {
      "nome": "diagnostico_tentativas_duracao_ms_check",
      "tipo": "c",
      "tabela": "diagnostico_tentativas",
      "definicao": "CHECK ((duracao_ms >= 0))"
    },
    {
      "nome": "diagnostico_tentativas_estado_check",
      "tipo": "c",
      "tabela": "diagnostico_tentativas",
      "definicao": "CHECK ((estado = ANY (ARRAY['reservada'::text, 'concluida'::text, 'falha'::text, 'bloqueada'::text])))"
    },
    {
      "nome": "diagnostico_tentativas_ordinal_check",
      "tipo": "c",
      "tabela": "diagnostico_tentativas",
      "definicao": "CHECK (((ordinal >= 1) AND (ordinal <= 5)))"
    },
    {
      "nome": "diagnostico_tentativas_recurso_check",
      "tipo": "c",
      "tabela": "diagnostico_tentativas",
      "definicao": "CHECK ((recurso = ANY (ARRAY['formas_pagamento'::text, 'recebimentos'::text, 'pagamentos'::text, 'recebimentos_titulos'::text, 'titulos'::text])))"
    },
    {
      "nome": "diagnostico_tentativas_status_http_check",
      "tipo": "c",
      "tabela": "diagnostico_tentativas",
      "definicao": "CHECK (((status_http >= 100) AND (status_http <= 599)))"
    },
    {
      "nome": "diagnostico_tentativas_tipo_excecao_check",
      "tipo": "c",
      "tabela": "diagnostico_tentativas",
      "definicao": "CHECK ((tipo_excecao = ANY (ARRAY['TypeError'::text, 'Error'::text, 'AbortError'::text, 'TimeoutError'::text, 'DOMException'::text, 'nao_identificado'::text, 'codigo_dns'::text, 'codigo_tls'::text, 'codigo_conexao'::text])))"
    },
    {
      "nome": "integracao_itens_referencia_origem_check",
      "tipo": "c",
      "tabela": "integracao_itens",
      "definicao": "CHECK (((length(referencia_origem) >= 3) AND (length(referencia_origem) <= 300)))"
    },
    {
      "nome": "integracao_itens_situacao_check",
      "tipo": "c",
      "tabela": "integracao_itens",
      "definicao": "CHECK ((situacao = ANY (ARRAY['novo'::text, 'existente'::text, 'alterado'::text, 'enviado_conferencia'::text, 'possivel_duplicidade'::text])))"
    },
    {
      "nome": "integracao_itens_tipo_check",
      "tipo": "c",
      "tabela": "integracao_itens",
      "definicao": "CHECK ((tipo = ANY (ARRAY['pagamento'::text, 'recebimento_titulo'::text, 'titulo_aberto'::text])))"
